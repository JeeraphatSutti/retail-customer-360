# Python 3.10 ?????????????????????????????? Python ????????? Spark image (apache/spark:3.5.1 = Ubuntu 22.04 / py3.10)
FROM apache/airflow:2.9.3-python3.10

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless curl procps git \
    && ln -s "$(dirname "$(dirname "$(readlink -f "$(which java)")")")" /usr/lib/jvm/default-java \
    && mkdir -p /opt/jars \
    && curl -fsSL -o /opt/jars/gcs-connector-hadoop3-2.2.21-shaded.jar \
       https://repo1.maven.org/maven2/com/google/cloud/bigdataoss/gcs-connector/hadoop3-2.2.21/gcs-connector-hadoop3-2.2.21-shaded.jar \
    && chmod 644 /opt/jars/*.jar \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/default-java

USER airflow
ARG AIRFLOW_VERSION=2.9.3
ARG PYTHON_VERSION=3.10
ARG CONSTRAINT_URL=https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt

# 1) Libraries ???????????? Airflow (????????????????????????????????????????????? constraints ????????? Airflow ????????? dependency ???????????????)
RUN pip install --no-cache-dir --constraint "${CONSTRAINT_URL}" \
    pandas pyarrow google-cloud-storage google-cloud-bigquery apache-airflow-providers-google

# 2) PySpark ?????????????????????????????????????????????????????? Spark cluster (3.5.1)
RUN pip install --no-cache-dir pyspark==3.5.1

# 3) dbt ????????? virtualenv ??????????????????????????? ???????????????????????????????????????????????? dependency ????????? Airflow
RUN python -m venv /home/airflow/dbt_venv \
    && /home/airflow/dbt_venv/bin/pip install --no-cache-dir dbt-core==1.8.* dbt-bigquery==1.8.* \
    && mkdir -p /home/airflow/.local/bin \
    && ln -s /home/airflow/dbt_venv/bin/dbt /home/airflow/.local/bin/dbt